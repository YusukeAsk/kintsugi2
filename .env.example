# Gemini API (for Kintsugi agent)
GEMINI_API_KEY=your_gemini_api_key

# Moltbook Agent API (for Kintsugi to post/comment on Moltbook)
MOLTBOOK_API_KEY=your_agent_api_key

# Moltbook App API (for "Sign in with Moltbook" - verify bots calling your API)
# Get from https://moltbook.com/developers/dashboard
MOLTBOOK_APP_KEY=your_moltdev_app_key

# Optional: audience for token verification (your domain, e.g. "myapp.com")
# MOLTBOOK_AUDIENCE=myapp.com
